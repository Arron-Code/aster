generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  SERVED
  PAID
  CANCELLED
}
enum MenuCategory {
  FOOD
  DRINK
  COFFEE
}
enum StockMovementType {
  RECEIPT
  CONSUMPTION
  ADJUSTMENT
  WASTE
}
enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}
enum PurchaseOrderItemStatus {
  ORDERED
  RECEIVED
  CANCELLED
}
enum PaymentStatus {
  UNPAID
  PAID
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
}

enum EventStatus {
  PLANNED
  ONGOING
  COMPLETED
}

enum UserRole {
  ADMIN
  MANAGER
  SERVICE
  KITCHEN
  BACKOFFICE
}

enum AccountingAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  TAX
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashTransactionType {
  SALE
  REFUND
  CASH_IN
  CASH_OUT
  TIP
  DIFFERENCE
}

enum PaymentMethod {
  CASH
  CARD
  PAYPAL
  OTHER
}

enum OperatingCostCategory {
  PERSONNEL
  OPERATING_SUPPLIES
  PRODUCTS
  CONTRACT
  RENT
  UTILITIES
  MARKETING
  INSURANCE
  TAX
  OTHER
}

enum ContractBillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
}

enum ContractStatus {
  ACTIVE
  PAUSED
  TERMINATED
}

model RestaurantTable {
  id String @id @default(cuid())
  number Int @unique
  token String @unique
  active Boolean @default(true)
  occupied Boolean @default(false)
  orders Order[]
  reservations Reservation[]
}

model Reservation {
  id String @id @default(cuid())
  tableId String
  table RestaurantTable @relation(fields: [tableId], references: [id])
  guestName String
  phone String?
  email String?
  guestCount Int @default(2)
  reservationDate DateTime
  reservationTime String
  notes String?
  status ReservationStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tableId, reservationDate])
}

model Event {
  id String @id @default(cuid())
  title String
  category String
  eventDate DateTime
  location String
  capacity Int @default(30)
  priceCents Int @default(0)
  description String?
  status EventStatus @default(PLANNED)
  attendees EventAttendee[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, eventDate])
}

model EventAttendee {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name String
  createdAt DateTime @default(now())
  @@unique([eventId, name])
}

model MenuItem {
  id String @id @default(cuid())
  name String
  description String
  imageUrl String?
  priceCents Int
  category MenuCategory @default(FOOD)
  available Boolean @default(true)
  sortOrder Int @default(0)
  quantity Int @default(0)
  unit String @default("Stück")
  deliveryTimeDays Int?
  supplierId String?
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderItems OrderItem[]
  recipeItems RecipeItem[]
  purchaseItems PurchaseOrderItem[]
  @@index([supplierId])
}

model Order {
  id String @id @default(cuid())
  tableId String
  table RestaurantTable @relation(fields: [tableId], references: [id])
  status OrderStatus @default(NEW)
  note String?
  inventoryPostedAt DateTime?
  paymentStatus PaymentStatus @default(UNPAID)
  paypalOrderId String? @unique
  paidAt DateTime?
  items OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stockMovements StockMovement[]
  cashTransactions CashTransaction[]
  journalEntries JournalEntry[]
  @@index([status, createdAt])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
  quantity Int
  unitPriceCents Int
  active Boolean @default(true)
}

model Ingredient {
  id String @id @default(cuid())
  name String @unique
  unit String
  stock Decimal @default(0) @db.Decimal(12, 3)
  minimumStock Decimal @default(0) @db.Decimal(12, 3)
  costPerUnitCents Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipeItems RecipeItem[]
  stockMovements StockMovement[]
  purchaseItems PurchaseOrderItem[]
}

model RecipeItem {
  id String @id @default(cuid())
  menuItemId String
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  quantity Decimal @db.Decimal(12, 3)
  @@unique([menuItemId, ingredientId])
}

model Supplier {
  id String @id @default(cuid())
  name String @unique
  email String?
  phone String?
  address String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchaseOrders PurchaseOrder[]
  menuItems MenuItem[]
}

model PurchaseOrder {
  id String @id @default(cuid())
  supplierId String
  supplier Supplier @relation(fields: [supplierId], references: [id])
  status PurchaseOrderStatus @default(DRAFT)
  note String?
  orderedAt DateTime?
  receivedAt DateTime?
  supplierConfirmation String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items PurchaseOrderItem[]
  stockMovements StockMovement[]
}

model PurchaseOrderItem {
  id String @id @default(cuid())
  purchaseOrderId String
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId String?
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id])
  menuItemId String?
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id])
  quantity Decimal @db.Decimal(12, 3)
  unitCostCents Int
  deliveryTimeDays Int?
  taxRatePercent Decimal @default(19.00) @db.Decimal(5, 2)
  status PurchaseOrderItemStatus @default(ORDERED)
  receivedQuantity Decimal? @db.Decimal(12, 3)
  receivedUnitCostCents Int?
  receivedAt DateTime?
  @@index([menuItemId])
  @@index([ingredientId])
}

model StockMovement {
  id String @id @default(cuid())
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  type StockMovementType
  quantity Decimal @db.Decimal(12, 3)
  reason String?
  orderId String?
  order Order? @relation(fields: [orderId], references: [id])
  purchaseOrderId String?
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  createdAt DateTime @default(now())
  @@index([ingredientId, createdAt])
}

model StaffMember {
  id String @id @default(cuid())
  name String
  email String @unique
  personnelNumber String @unique
  passwordHash String
  phone String?
  role UserRole @default(SERVICE)
  department String @default("Service")
  active Boolean @default(true)
  openedCashSessions CashSession[] @relation("CashSessionOpenedBy")
  closedCashSessions CashSession[] @relation("CashSessionClosedBy")
  cashTransactions CashTransaction[] @relation("CashTransactionCreatedBy")
  journalEntries JournalEntry[] @relation("JournalEntryCreatedBy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OperatingCost {
  id            String                @id @default(cuid())
  category      OperatingCostCategory
  title         String
  vendor        String?
  amountCents   Int
  occurredAt    DateTime              @default(now())
  costMonth     String?
  note          String?
  contractId    String?
  contract      Contract?             @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  @@index([category, occurredAt])
  @@index([contractId])
}

model Contract {
  id                     String                @id @default(cuid())
  title                  String
  partnerName            String
  contractNumber         String?
  category               OperatingCostCategory @default(CONTRACT)
  startDate              DateTime
  endDate                DateTime?
  billingCycle           ContractBillingCycle  @default(MONTHLY)
  monthlyAmountCents     Int
  totalAmountCents       Int
  cancellationPeriodDays Int?
  status                 ContractStatus        @default(ACTIVE)
  note                   String?
  costs                  OperatingCost[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  @@index([status, category])
  @@index([startDate])
}

model SiteSetting {
  id String @id @default(cuid())
  key String @unique
  value String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id String @id @default(cuid())
  endpoint String @unique
  p256dh String
  auth String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccountingAccount {
  id          String                @id @default(cuid())
  number      String                @unique
  name        String
  type        AccountingAccountType
  description String?
  active      Boolean               @default(true)
  journalLines JournalLine[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model TaxRate {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  rate        Decimal  @db.Decimal(5, 2)
  validFrom   DateTime
  active      Boolean  @default(true)
  journalLines JournalLine[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([active, validFrom])
}

model CashRegister {
  id          String        @id @default(cuid())
  name        String        @unique
  location    String?
  active      Boolean       @default(true)
  sessions    CashSession[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model CashSession {
  id                  String              @id @default(cuid())
  registerId          String
  register            CashRegister         @relation(fields: [registerId], references: [id])
  status              CashSessionStatus    @default(OPEN)
  openingBalanceCents Int
  closingBalanceCents Int?
  expectedBalanceCents Int?
  openedAt            DateTime            @default(now())
  closedAt            DateTime?
  openedById          String?
  openedBy            StaffMember?        @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  closedById          String?
  closedBy            StaffMember?        @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  transactions        CashTransaction[]
  journalEntries      JournalEntry[]
  @@index([registerId, status])
  @@index([openedAt])
}

model CashTransaction {
  id              String               @id @default(cuid())
  sessionId       String
  session         CashSession          @relation(fields: [sessionId], references: [id])
  type            CashTransactionType
  paymentMethod   PaymentMethod
  amountCents     Int
  orderId         String?
  order           Order?               @relation(fields: [orderId], references: [id])
  reference       String?
  note            String?
  occurredAt      DateTime             @default(now())
  createdById     String?
  createdBy       StaffMember?         @relation("CashTransactionCreatedBy", fields: [createdById], references: [id])
  journalEntry    JournalEntry?
  @@index([sessionId, occurredAt])
  @@index([orderId])
}

model JournalEntry {
  id             String          @id @default(cuid())
  entryNumber    String          @unique
  entryDate      DateTime        @default(now())
  description    String
  postedAt       DateTime?
  orderId        String?
  order          Order?          @relation(fields: [orderId], references: [id])
  sessionId      String?
  session        CashSession?    @relation(fields: [sessionId], references: [id])
  cashTransactionId String?      @unique
  cashTransaction CashTransaction? @relation(fields: [cashTransactionId], references: [id])
  createdById    String?
  createdBy      StaffMember?    @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])
  lines          JournalLine[]
  createdAt      DateTime        @default(now())
  @@index([entryDate])
  @@index([orderId])
}

model JournalLine {
  id              String             @id @default(cuid())
  journalEntryId  String
  journalEntry    JournalEntry      @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId       String
  account         AccountingAccount  @relation(fields: [accountId], references: [id])
  taxRateId       String?
  taxRate         TaxRate?           @relation(fields: [taxRateId], references: [id])
  description     String?
  debitCents      Int                @default(0)
  creditCents     Int                @default(0)
  @@index([accountId, journalEntryId])
}
